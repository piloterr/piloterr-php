{
    "name": "piloterr/sdk",
    "description": "Official PHP SDK for the Piloterr web scraping API.",
    "type": "library",
    "keywords": [
        "api",
        "data-extraction",
        "piloterr",
        "scraper-api",
        "scraping",
        "sdk",
        "web-scraping"
    ],
    "homepage": "https://www.piloterr.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Piloterr",
            "email": "contact@piloterr.com"
        }
    ],
    "support": {
        "issues": "https://github.com/piloterr/piloterr-php/issues",
        "source": "https://github.com/piloterr/piloterr-php",
        "docs": "https://app.piloterr.com/openapi"
    },
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.6",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Piloterr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Piloterr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=1G",
        "check": [
            "@format:check",
            "@analyse",
            "@test"
        ],
        "format": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "format:check": "php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff",
        "test": "phpunit --configuration=phpunit.xml.dist"
    },
    "config": {
        "sort-packages": true
    }
}
